{
    "name": "bpmore/statamic-grange",
    "description": "Generates and maintains a site's accessibility statement, refuses to claim more than the evidence supports, and keeps the evidence.",
    "keywords": [
        "statamic",
        "accessibility",
        "a11y",
        "wcag",
        "accessibility-statement",
        "compliance"
    ],
    "license": "proprietary",
    "type": "statamic-addon",
    "homepage": "https://hada.farm",
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.27"
    },
    "require-dev": {
        "orchestra/testbench": "^10.11 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bpmore\\Grange\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\Grange\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "statamic": {
            "name": "Grange",
            "slug": "statamic-grange"
        },
        "laravel": {
            "providers": [
                "Bpmore\\Grange\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
